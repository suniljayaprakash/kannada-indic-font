# EditorConfig for consistent coding style across editors
# See https://editorconfig.org for more info

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Feature files (.fea)
[*.fea]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2
