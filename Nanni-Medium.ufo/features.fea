### feature:6:rphf ###
feature rphf {
### open feature 'rphf' ###
lookup reph_form {
  sub uni0CB0 uni0CCD by uni0CEF;
} reph_form;

script knda;
# Apply rephf, but exceptions can suppress it via ZWJ in shaping context
sub @KannadaAll uni0CB0' lookup reph_form uni0CCD';
### close feature 'rphf' ###
} rphf;

