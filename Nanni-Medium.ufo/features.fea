### feature:2:akhn ###
feature akhn {
### open feature 'akhn' ###
lookup akhn_matras {
  # shrii ligature variants (simple rules that work)
#  sub uni0CB6 uni200D by uniE7B1;
#  sub uni0CB6 uni200C by uni0CDC;


  # HarfBuzz decomposes split vowels before any feature fires:
  #   U+0CCA (oMatra)  -> U+0CC6 (eMatra) + U+0CC2 (uuMatra)
  #   U+0CCB (ooMatra) -> U+0CC6 (eMatra) + U+0CC2 (uuMatra) + U+0CD5 (uni0CD5)
  # These 3-glyph and 4-glyph ligature rules match the decomposed sequences
  # at akhn time (before reordering) and form the correct precomposed glyph.

  # --- oMatra: consonant + uni0CC6 + uni0CC2 ---
  sub uni0C95 uni0CC6 uni0CC2 by uniE61F;
  sub uni0C96 uni0CC6 uni0CC2 by uniE62A;
  sub uni0C97 uni0CC6 uni0CC2 by uniE634;
